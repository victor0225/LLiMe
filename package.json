{
  "name": "llime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx watch src/server.ts --dev",
    "build": "vite build",
    "start": "tsx src/server.ts",
    "storybook": "tsx .storybook/serve.ts",
    "build-storybook": "storybook build --disable-telemetry",
    "test:e2e": "playwright test",
    "setup:env": "node scripts/setup-env.mjs",
    "db:up": "docker compose -p llime-local up -d --wait",
    "doctor": "tsx scripts/doctor.ts",
    "dataset": "tsx scripts/dataset.ts",
    "seed": "tsx scripts/seed.ts",
    "live:codex": "tsx scripts/live-codex.ts",
    "live:voice": "tsx scripts/live-voice.ts"
  },
  "dependencies": {
    "@json-render/core": "0.22.0",
    "@json-render/react": "0.22.0",
    "@openai/codex": "0.166.0",
    "neo4j-driver": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@storybook/react-vite": "10.6.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "storybook": "10.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
