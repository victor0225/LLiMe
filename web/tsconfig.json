{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@core/*": ["../src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../src/domain.ts", "../src/events.ts", "../src/routes.ts", "../src/copy.ts"]
}
