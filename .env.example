# Worktree settings. npm run setup:env fills the database credential; never type secrets here by hand.
# A variable set in the shell wins over this file. An empty value means "use the default".

# Local Neo4j shared by every worktree on this computer (default bolt://127.0.0.1:17687, user neo4j).
NEO4J_URI=
NEO4J_USER=
# The machine credential from ~/.config/llime/neo4j.env, copied by setup:env.
NEO4J_PASSWORD=

# Loopback ports assigned per Task (defaults 4317, 5173, 6006). The app origin is http://127.0.0.1:PORT.
PORT=
VITE_PORT=
STORYBOOK_PORT=

# Codex model for new runs: gpt-6.1-terra (default) or gpt-6.1-sol.
LLIME_MODEL=
# Fast service tier ID reported by the account's model list.
LLIME_SERVICE_TIER=

# added by setup:env from the main checkout or ~/.config/llime/provider.env (0600); leave empty on computers without a key
OPENAI_API_KEY=
